{
  "compilerOptions": {
    "declaration": true,
    "declarationMap": false,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@configuration": [
        "./src/graphz.config.json"
      ],
      "@core/*": [
        "./src/core/*"
      ],
      "@domain/*": [
        "./src/domain/*"
      ],
      "@factories/*": [
        "./src/factories/*"
      ],
      "@graphz": [
        "./src/index.ts"
      ],
      "@services/*": [
        "./src/services/*"
      ]
    },
    "resolveJsonModule": true,
    "rootDir": "src",
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": []
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.json"
  ],
  "exclude": [
    "src/**/*.test.ts"
  ]
}

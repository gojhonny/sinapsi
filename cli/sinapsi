#!/bin/sh
set -eu

SINAPSI_INVOCATION_DIR=$(pwd -P)
export GRAPH_INVOCATION_DIR="$SINAPSI_INVOCATION_DIR"

sinapsi_source=$0
while [ -L "$sinapsi_source" ]; do
  sinapsi_source_dir=$(CDPATH= cd -P "$(dirname "$sinapsi_source")" && pwd)
  sinapsi_link=$(readlink "$sinapsi_source")
  case "$sinapsi_link" in
    /*) sinapsi_source=$sinapsi_link ;;
    *) sinapsi_source=$sinapsi_source_dir/$sinapsi_link ;;
  esac
done

CLI_ROOT=$(CDPATH= cd -P "$(dirname "$sinapsi_source")" && pwd)

case "${1:-}" in
  --setup)
    shift
    set -- setup "$@"
    ;;
esac

exec "$CLI_ROOT/src/graph.sh" "$@"
